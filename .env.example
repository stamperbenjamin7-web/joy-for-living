# Stripe secret key (server-side only) — required to enable the $10 card
# deposit for beach chair & umbrella delivery reservations.
# Get it from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here

# Public URL of the deployed site, used to build Stripe Checkout redirect
# URLs. Falls back to the request origin if not set, so it's optional for
# local development.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (optional, only needed for the next-auth login flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
