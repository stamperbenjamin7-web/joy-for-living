# PayPal REST API credentials (server-side only) — required to enable the
# $10 card deposit for beach chair & umbrella delivery reservations.
# Create an app at https://developer.paypal.com/dashboard/applications to get
# a Client ID and Secret. Stripe isn't used here because Stripe doesn't
# support merchant accounts based in Aruba — PayPal does.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# 'sandbox' (default, safe for testing with developer.paypal.com sandbox
# accounts) or 'live' once you have real, live PayPal app credentials above.
PAYPAL_ENV=sandbox

# Public URL of the deployed site, used to build PayPal return/cancel URLs.
# Falls back to the request origin if not set, so it's optional for local dev.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (optional, only needed for the next-auth login flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
